---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
---

<Layout title="XEN — Schedule">
    <Navbar />

    <main class="schedule-page">

        <section class="schedule-page-hero">

            <div class="schedule-page-meta">
                <span>05</span>
                <span>Schedule</span>
            </div>

            <div class="schedule-page-title-wrap">

                <span class="schedule-page-kicker">
                    UPCOMING EVENTS
                </span>

                <h1 class="schedule-page-title">
                    Schedule<span>.</span>
                </h1>

            </div>

            <div class="schedule-page-year">
                2026
            </div>

        </section>


        <section class="schedule-page-list">

            <!-- EVENT 01 -->

            <div class="schedule-page-item">

                <div class="schedule-page-date">

                    <span class="schedule-page-month">
                        MONTH
                    </span>

                    <span class="schedule-page-day">
                        00
                    </span>

                    <span class="schedule-page-weekday">
                        DAY
                    </span>

                </div>


                <div class="schedule-page-info">

                    <span class="schedule-page-type">
                        DON'T KNOW
                    </span>

                    <h2>
                        Unschedule
                    </h2>

                    <span class="schedule-page-time">
                        00:00
                    </span>

                </div>

            </div>


            <!-- EVENT 02 -->

            <div class="schedule-page-item">

                <div class="schedule-page-date">

                    <span class="schedule-page-month">
                        MONTH
                    </span>

                    <span class="schedule-page-day">
                        00
                    </span>

                    <span class="schedule-page-weekday">
                        DAY
                    </span>

                </div>


                <div class="schedule-page-info">

                    <span class="schedule-page-type">
                        DON'T KNOW
                    </span>

                    <h2>
                        Unschedule
                    </h2>

                    <span class="schedule-page-time">
                        00:00
                    </span>

                </div>

            </div>


            <!-- EVENT 03 -->

            <div class="schedule-page-item">

                <div class="schedule-page-date">

                    <span class="schedule-page-month">
                        SEP
                    </span>

                    <span class="schedule-page-day">
                        19
                    </span>

                    <span class="schedule-page-weekday">
                        SATURDAY
                    </span>

                </div>


                <div class="schedule-page-info">

                    <span class="schedule-page-type">
                        BIRTHDAY
                    </span>

                    <h2>
                        Kahi Tanjoubi
                    </h2>

                    <span class="schedule-page-time">
                        00:00
                    </span>

                </div>

            </div>


            <!-- EVENT 04 -->

            <div class="schedule-page-item">

                <div class="schedule-page-date">

                    <span class="schedule-page-month">
                        MONTH
                    </span>

                    <span class="schedule-page-day">
                        00
                    </span>

                    <span class="schedule-page-weekday">
                        DAY
                    </span>

                </div>


                <div class="schedule-page-info">

                    <span class="schedule-page-type">
                        DON'T KNOW
                    </span>

                    <h2>
                        Unschedule
                    </h2>

                    <span class="schedule-page-time">
                        00:00
                    </span>

                </div>

            </div>

        </section>


        <div class="schedule-page-note">

            <span>
                All dates are subject to change.
            </span>

            <span>
                XEN / 2026
            </span>

        </div>

    </main>
</Layout>