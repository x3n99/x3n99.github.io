---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
---

<Layout title="XEN — Coming Soon">
    <Navbar />

    <main class="coming-soon-page">

        <section class="coming-soon-hero">

            <div class="coming-soon-meta">
                <span>00</span>
                <span>SOMETHING IS COMING</span>
            </div>

            <div class="coming-soon-content">

                <span class="coming-soon-kicker">
                    
                </span>

                <h1>
                    Coming Soon<span>.</span>
                </h1>

                <p>
                    This part of XEN is still being prepared.
                    Please come back later.
                </p>

                <a
                    href="/"
                    class="coming-soon-back"
                    data-cursor="BACK"
                >
                    BACK TO HOME
                    <span>↗</span>
                </a>

            </div>

            <div class="coming-soon-year">
                2026
            </div>

        </section>

    </main>
</Layout>