---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
---

<Layout title="Profile — XEN">

    <Navbar />

    <main class="profile-page">

        <section class="profile-hero">

            <div class="hero-meta">
                <span>01</span>
                <span>PROFILE</span>
            </div>

            <div class="profile-hero-content">

                <p class="eyebrow">
                    VAMPIRE
                </p>

                <h1>
                    XEN
                </h1>

                <p class="hero-description">
                    A voice in the dark.
                </p>

            </div>

            <div class="hero-bottom">
                <span>OFFICIAL PROFILE</span>
                <span>2026</span>
            </div>

        </section>


        <section class="profile-section about-section">

            <div class="section-label">
                <span>02</span>
                <span>ABOUT</span>
            </div>

            <div class="about-grid">

                <div class="about-title">

                    <h2>
                        THE VOICE<br />
                        BEHIND <span>XEN.</span>
                    </h2>

                </div>


                <div class="about-text">

                    <p>
                        Xen is a mysterious vampire with a passion
                        for singing.
                    </p>

                    <p>
                        Despite his dark and otherworldly nature,
                        he finds comfort and joy in music, often
                        expressing his emotions through his voice.
                    </p>

                    <p>
                        Through music, Xen creates a space where
                        darkness, emotion and melody meet.
                    </p>

                </div>

            </div>

        </section>


        <section class="profile-section artist-section">

            <div class="section-label">
                <span>03</span>
                <span>ARTIST</span>
            </div>

            <div class="artist-grid">

                <div class="artist-heading">

                    <p class="eyebrow">
                        ARTIST INFORMATION
                    </p>

                    <h2>
                        XEN
                    </h2>

                </div>


                <div class="artist-details">

                    <div class="detail-row">
                        <span>NAME</span>
                        <strong>XEN</strong>
                    </div>

                    <div class="detail-row">
                        <span>BIRTHDAY</span>
                        <strong>31 OCT</strong>
                    </div>

                    <div class="detail-row">
                        <span>RACE</span>
                        <strong>VAMPIRE</strong>
                    </div>

                    <div class="detail-row">
                        <span>ACTIVITY</span>
                        <strong>MUSIC</strong>
                    </div>

                    <div class="detail-row">
                        <span>YEAR</span>
                        <strong>2026 — PRESENT</strong>
                    </div>

                </div>

            </div>

        </section>


        <section class="profile-section profile-music-section">

            <div class="section-label">
                <span>04</span>
                <span>MUSIC</span>
            </div>

            <div class="music-grid">

                <div class="music-intro">

                    <p class="eyebrow">
                        SOUND / VOICE
                    </p>

                    <h2>
                        MUSIC IS<br />
                        THE LANGUAGE.
                    </h2>

                </div>


                <div class="music-description">

                    <p>
                        From powerful performances to quieter,
                        emotional arrangements, every song becomes
                        another part of XEN's story.
                    </p>

                    <a href="/#music" class="text-link">
                        EXPLORE MUSIC
                        <span>↗</span>
                    </a>

                </div>

            </div>

        </section>


        <section class="profile-section social-section">

            <div class="section-label">
                <span>05</span>
                <span>FOLLOW</span>
            </div>

            <div class="social-grid">

                <div class="social-heading">

                    <h2>
                        FIND XEN
                        <span> ELSEWHERE.</span>
                    </h2>

                </div>


                <div class="social-links">

                    <a href="https://instagram.com/superxen_" target="_blank">
                        <span>INSTAGRAM</span>
                        <i class="fa-brands fa-instagram"></i>
                    </a>

                    <a href="/coming-soon" >
                        <span>YOUTUBE</span>
                        <i class="fa-brands fa-youtube"></i>
                    </a>

                    <a href="/coming-soon" >
                        <span>X</span>
                        <i class="fa-brands fa-x-twitter"></i>
                    </a>

                </div>

            </div>

        </section>

    </main>

</Layout>