---
import "../styles/global.css";

interface Props {
    title?: string;
}

const { title = "XEN — UTAITE" } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="theme-color" content="#080808" />
        <meta
            name="description"
            content="XEN"
        />
        <link
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
        />
        <script is:inline>
            const loaderShown =
                sessionStorage.getItem("xenLoaderShown");

            if (loaderShown === "true") {
                document.documentElement.classList.add(
                    "loader-already-shown"
                );
            }
        </script>
        <title>{title}</title>
    </head>

    <body>
        <div class="page-loader" id="pageLoader" aria-hidden="true">

            <div class="loader-content">

                <span class="loader-name">
                    XEN
                </span>

                <div class="loader-line">
                    <span></span>
                </div>

                <span class="loader-status">
                    ENTERING
                </span>

            </div>

        </div>
        <div class="custom-cursor" id="customCursor">
            <span></span>
        </div>
        <div class="page-transition" id="pageTransition">
            <div class="page-transition-line"></div>
            <span class="page-transition-label">
                XEN
            </span>
        </div>
        <slot />
        <footer class="site-footer">

			<div class="footer-inner">

				<div class="footer-main">

					<div class="footer-brand">

						<h2>
							XEN
						</h2>

					</div>


					<div class="footer-links">

						<a href="https://instagram.com/superxen_" target="_blank" data-cursor="VISIT">
							Instagram
							<span>↗</span>
						</a>

						<a href="/coming-soon"  data-cursor="VISIT">
							YouTube
							<span>↗</span>
						</a>

						<a href="/coming-soon"  data-cursor="VISIT">
							X
							<span>↗</span>
						</a>

					</div>

				</div>


				<div class="footer-bottom">

					<span>
						© 2026 XEN
					</span>

					<button
						type="button"
						id="backToTop"
						data-cursor="TOP"
					>
						BACK TO TOP ↑
					</button>

				</div>

			</div>

		</footer>
        <script>
            const cursor =
                document.querySelector("#customCursor");

            if (cursor) {

                const cursorText =
                    cursor.querySelector("span");


                /* =========================================
                MOUSE MOVE
                ========================================= */

                document.addEventListener(
                    "mousemove",
                    (event) => {

                        cursor.style.left =
                            `${event.clientX}px`;

                        cursor.style.top =
                            `${event.clientY}px`;

                        cursor.style.opacity = "1";

                    },
                    {
                        passive: true,
                    }
                );


                /* =========================================
                HOVER
                ========================================= */

                document.addEventListener(
                    "mouseover",
                    (event) => {

                        const target =
                            event.target.closest(
                                "a, button, [data-cursor]"
                            );

                        if (!target) return;


                        cursor.classList.add("hover");


                        if (cursorText) {

                            cursorText.textContent =
                                target.dataset.cursor || "";

                        }

                    }
                );


                /* =========================================
                LEAVE
                ========================================= */

                document.addEventListener(
                    "mouseout",
                    (event) => {

                        const target =
                            event.target.closest(
                                "a, button, [data-cursor]"
                            );

                        if (!target) return;


                        const relatedTarget =
                            event.relatedTarget;


                        /*
                        * Jangan menghilangkan hover ketika
                        * pointer hanya berpindah ke child
                        * dari elemen yang sama.
                        */

                        if (
                            relatedTarget &&
                            target.contains(relatedTarget)
                        ) {
                            return;
                        }


                        cursor.classList.remove("hover");


                        if (cursorText) {

                            cursorText.textContent = "";

                        }

                    }
                );

            }
            /* =========================================
            CURSOR — VIDEO SECTION
            ========================================= */

            const videoSection =
                document.querySelector(".video-section");

            const customCursor =
                document.querySelector(".custom-cursor");

            if (videoSection && customCursor) {

                videoSection.addEventListener(
                    "mouseenter",
                    () => {
                        customCursor.classList.add(
                            "light-section"
                        );
                    }
                );

                videoSection.addEventListener(
                    "mouseleave",
                    () => {
                        customCursor.classList.remove(
                            "light-section"
                        );
                    }
                );

            }
        </script>
        <script>
            import "../scripts/animations.js";
        </script>

        <script>
            const header = document.querySelector(".site-header");
            const menuButton = document.querySelector("#menuButton");
            const menuOverlay = document.querySelector("#menuOverlay");
            const menuLinks = document.querySelectorAll(".menu-links a");

            // Header scroll state
            window.addEventListener("scroll", () => {
                if (!header) return;

                header.classList.toggle(
                    "scrolled",
                    window.scrollY > 40
                );
            });

            // Open / close menu
            menuButton?.addEventListener("click", () => {
                const isOpen = menuOverlay?.classList.toggle("active");

                menuButton.classList.toggle("active", isOpen);
                menuButton.setAttribute(
                    "aria-expanded",
                    String(isOpen)
                );

                document.body.style.overflow = isOpen
                    ? "hidden"
                    : "";
            });

            // Close menu when clicking navigation
            menuLinks.forEach((link) => {
                link.addEventListener("click", () => {
                    menuOverlay?.classList.remove("active");
                    menuButton?.classList.remove("active");

                    menuButton?.setAttribute(
                        "aria-expanded",
                        "false"
                    );

                    document.body.style.overflow = "";
                });
            });
        </script>
        <script>
            console.log(
                "LOADER CHECK:",
                sessionStorage.getItem("xenLoaderShown")
            );
            const pageLoader =
                document.querySelector("#pageLoader");

            const loaderShown =
                sessionStorage.getItem("xenLoaderShown");


            if (loaderShown === "true") {

                /*
                * Loader sudah pernah dijalankan.
                * Jangan tampilkan lagi.
                */
                pageLoader?.remove();

                document.body.classList.add(
                    "page-ready"
                );


            } else {

                /*
                * FIRST VISIT
                */

                sessionStorage.setItem(
                    "xenLoaderShown",
                    "true"
                );


                setTimeout(() => {

                    pageLoader?.classList.add(
                        "hidden"
                    );


                    setTimeout(() => {

                        document.body.classList.add(
                            "page-ready"
                        );

                    }, 300);

                }, 1800);

            }
        </script>
        <script>
            const profileSection =
                document.querySelector("#profile");

            if (profileSection) {
                const profileObserver =
                    new IntersectionObserver(
                        (entries) => {
                            entries.forEach((entry) => {
                                if (!entry.isIntersecting) return;

                                entry.target.classList.add("is-visible");

                                profileObserver.unobserve(
                                    entry.target
                                );
                            });
                        },
                        {
                            threshold: 0.2
                        }
                    );

                profileObserver.observe(profileSection);
            }
        </script>
        <script>
            const profileWatermark =
                document.querySelector(".profile-watermark");

            const profile =
                document.querySelector("#profile");

            if (profileWatermark && profile) {

                window.addEventListener("scroll", () => {

                    const rect =
                        profile.getBoundingClientRect();

                    const offset =
                        (window.innerHeight - rect.top) * 0.04;

                    profileWatermark.style.setProperty(
                        "--watermark-y",
                        `${offset}px`
                    );

                }, { passive: true });

            }
        </script>
        <script>
            // Music reveal
            const musicSection = document.querySelector("#music");

            if (musicSection) {
                const musicObserver = new IntersectionObserver(
                    (entries) => {
                        entries.forEach((entry) => {
                            if (!entry.isIntersecting) return;

                            musicSection.classList.add("music-visible");
                            musicObserver.unobserve(musicSection);
                        });
                    },
                    {
                        threshold: 0.2
                    }
                );

                musicObserver.observe(musicSection);
            }
        </script>
        <script>
            const videoSection = document.querySelector("#video");

            if (videoSection) {
                const videoObserver = new IntersectionObserver(
                    (entries) => {
                        entries.forEach((entry) => {
                            if (!entry.isIntersecting) return;

                            videoSection.classList.add("video-visible");

                            videoObserver.unobserve(videoSection);
                        });
                    },
                    {
                        threshold: 0.2
                    }
                );

                videoObserver.observe(videoSection);
            }
        </script>
        <div class="video-modal" id="videoModal">

            <button
                class="video-modal-close"
                id="videoModalClose"
                type="button"
                aria-label="Close video"
            >
                ×
            </button>

            <div class="video-modal-inner">

                <div class="video-modal-player">

                    <iframe
                        id="videoPlayer"
                        src=""
                        title="XEN Video Player"
                        frameborder="0"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        allowfullscreen
                    ></iframe>

                </div>

            </div>

        </div>
    </body>
</html>